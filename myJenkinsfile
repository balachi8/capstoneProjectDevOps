appImage = ""
pipeline {
    agent any

    tools {
        maven 'maven-3.10.0'
        jdk 'java17'
    }

    environment {
        // Adjust these variables based on your repository setup
        REPO_URL = 'https://github.com/balachi8/capstoneProjectDevOps.git'
        BRANCH_NAME = 'main'
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
        IMAGE_NAME = 'balachi8/my-capstone-project'
        IMAGE_TAG = "2.0.0"
        DOCKER_CONTEXT = 'default'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning code from repository...'
                git branch: "${BRANCH_NAME}", url: "${REPO_URL}"
            }
        }

        stage('Clean & Compile') {
            steps {
                echo 'Cleaning workspace and compiling the application...'
                sh 'mvn clean compile'
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo 'Executing unit tests...'
                sh 'mvn test'
            }
            post {
                always {
                    // Automatically parses target/surefire-reports and tracks test results in the Jenkins UI
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package Application') {
            steps {
                echo 'Packaging the application into a JAR file...'
                // Skips tests here since they were run in the previous dedicated stage
                sh 'mvn package -DskipTests'
            }
        }

       /* stage('Security Checks') {
                    parallel {
                        stage('SonarQube Static Analysis') {
                            steps {
                                withSonarQubeEnv('SonarQubeServer') {
                                    sh 'mvn sonar:sonar'
                                }
                            }
                        }
                    }
        }*/

        stage('Container Build') {
            steps {
                script {
                   appImage = docker.build("${DOCKER_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Push') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', passwordVariable: 'DOCKER_PASSWORD', usernameVariable: 'DOCKER_USERNAME')]) {
                        docker.withRegistry('https://docker.io', DOCKER_CREDENTIALS_ID) {
                            appImage.push("${IMAGE_TAG}")
                            appImage.push("latest")
                        }
                    }
                }
            }
        }

                stage('Deploy to Kubernetes') {
                    steps {
                        // Safely injects the kubeconfig to execute kubectl commands
                        withKubeConfig([credentialsId: 'my-k8s-config']) {
                            sh "kubectl create namespace myworkspace"
                            sh "kubectl apply -f k8s/configmap.yaml"
                            sh "kubectl apply -f k8s/deployment.yaml"
                        }
                    }
                }
            }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Please review the console output for troubleshooting.'
        }
    }
}